// ==============================================================================
// IGNITRON 2K26 — CODE RELAY PRISMA SCHEMA
// Database: MySQL 8.0 Community Edition
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum TeamStatus {
  ACTIVE
  DISQUALIFIED
  WITHDRAWN
}

enum AdminRole {
  SUPER_ADMIN
  ORGANIZER
  JUDGE
}

enum RoundStatus {
  UPCOMING
  ACTIVE
  PAUSED
  COMPLETED
}

enum EligibilityStatus {
  PENDING
  ELIGIBLE
  INELIGIBLE
}

enum ParticipationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  DISQUALIFIED
  TIMED_OUT
}

enum SubmissionStatus {
  PENDING
  EVALUATING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  EVALUATED
}

enum ActorType {
  SYSTEM
  ADMIN
  TEAM
}

enum SessionStatus {
  ACTIVE
  ENDED
  EXPIRED
  REVOKED
}

enum SessionTerminationReason {
  USER_LOGOUT
  TIMEOUT
  ADMIN_REVOKED
  DISPLACED
}

enum CompetitionStatus {
  STANDBY
  ROUND_1_ACTIVE
  ROUND_1_EVALUATION
  ROUND_2_ACTIVE
  ROUND_2_EVALUATION
  ROUND_3_ACTIVE
  FINAL_EVALUATION
  COMPLETED
}

enum QuestionType {
  MCQ
  BUG_HUNT
  CODING_CASE
}

// ------------------------------------------------------------------------------
// A. TEAM
// ------------------------------------------------------------------------------
model Team {
  id                 String     @id @default(cuid())
  teamCode           String     @unique @map("team_code")
  teamName           String     @map("team_name")
  institution        String?    @map("institution")
  passwordHash       String     @default("") @map("password_hash")
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  isActive           Boolean    @default(true) @map("is_active")
  isDemo             Boolean    @default(false) @map("is_demo")
  status             TeamStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  participants  Participant[]
  roundProgress TeamRoundProgress[]
  submissions   Submission[]
  sessions      TeamSession[]
  drafts        WorkspaceDraft[]
  mcqAnswers    TeamMcqAnswer[]

  @@map("teams")
}

// ------------------------------------------------------------------------------
// B. PARTICIPANT
// ------------------------------------------------------------------------------
model Participant {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  fullName  String   @map("full_name")
  email     String   @unique @map("email")
  phone     String?  @map("phone")
  studentId String?  @map("student_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team     Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sessions TeamSession[]

  @@index([teamId])
  @@map("participants")
}

// ------------------------------------------------------------------------------
// C. ADMIN ACCOUNT
// ------------------------------------------------------------------------------
model AdminAccount {
  id           String    @id @default(cuid())
  fullName     String    @map("full_name")
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ORGANIZER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  evaluations   Evaluation[]
  announcements Announcement[]

  @@map("admin_accounts")
}

// ------------------------------------------------------------------------------
// D. COMPETITION ROUND
// ------------------------------------------------------------------------------
model CompetitionRound {
  id              String      @id @default(cuid())
  roundNumber     Int         @unique @map("round_number")
  name            String      @map("name")
  description     String      @db.Text @map("description")
  durationMinutes Int         @map("duration_minutes")
  maximumMarks           Decimal     @db.Decimal(6, 2) @map("maximum_marks")
  status                 RoundStatus @default(UPCOMING)
  isLeaderboardPublished Boolean     @default(false) @map("is_leaderboard_published")
  leaderboardPublishedAt DateTime?   @map("leaderboard_published_at")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  teamProgress TeamRoundProgress[]
  submissions  Submission[]
  drafts       WorkspaceDraft[]
  questions    Question[]

  @@map("competition_rounds")
}

// ------------------------------------------------------------------------------
// E. TEAM ROUND PROGRESS
// ------------------------------------------------------------------------------
model TeamRoundProgress {
  id                  String              @id @default(cuid())
  teamId              String              @map("team_id")
  roundId             String              @map("round_id")
  eligibilityStatus   EligibilityStatus   @default(PENDING) @map("eligibility_status")
  participationStatus ParticipationStatus @default(NOT_STARTED) @map("participation_status")
  score               Decimal             @default(0.00) @db.Decimal(6, 2) @map("score")
  scoreBreakdown      Json?               @map("score_breakdown")
  startedAt           DateTime?           @map("started_at")
  submittedAt         DateTime?           @map("submitted_at")
  evaluatedAt         DateTime?           @map("evaluated_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  team  Team             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  round CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@unique([teamId, roundId])
  @@index([teamId])
  @@index([roundId])
  @@map("team_round_progress")
}

// ------------------------------------------------------------------------------
// F. SUBMISSION
// ------------------------------------------------------------------------------
model Submission {
  id               String           @id @default(cuid())
  teamId           String           @map("team_id")
  roundId          String?          @map("round_id")
  language         String           @map("language")
  sourceCode       String           @db.LongText @map("source_code")
  stdin            String?          @db.Text @map("stdin")
  stdout           String?          @db.LongText @map("stdout")
  stderr           String?          @db.LongText @map("stderr")
  compileOutput    String?          @db.LongText @map("compile_output")
  executionTime    Decimal?         @db.Decimal(8, 4) @map("execution_time")
  memoryUsage      Int?             @map("memory_usage")
  submissionStatus SubmissionStatus @default(PENDING) @map("submission_status")
  score            Decimal?         @db.Decimal(6, 2) @map("score")
  judge0Token      String?          @map("judge0_token")
  isTestRun        Boolean          @default(false) @map("is_test_run")
  questionId       String?          @map("question_id")
  testCaseResults  Json?            @map("test_case_results")
  submittedAt      DateTime         @default(now()) @map("submitted_at")
  evaluatedAt      DateTime?        @map("evaluated_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  team        Team              @relation(fields: [teamId], references: [id], onDelete: Restrict)
  round       CompetitionRound? @relation(fields: [roundId], references: [id], onDelete: Restrict)
  question    Question?         @relation(fields: [questionId], references: [id], onDelete: SetNull)
  evaluations Evaluation[]

  @@index([teamId])
  @@index([roundId])
  @@index([questionId])
  @@index([submissionStatus])
  @@index([isTestRun])
  @@map("submissions")
}

// ------------------------------------------------------------------------------
// G. EVALUATION
// ------------------------------------------------------------------------------
model Evaluation {
  id             String    @id @default(cuid())
  submissionId   String    @map("submission_id")
  evaluatorId    String?   @map("evaluator_id")
  teamId         String?   @map("team_id")
  roundNumber    Int?      @map("round_number")
  totalScore     Decimal   @db.Decimal(6, 2) @map("total_score")
  criteriaScores Json?     @map("criteria_scores")
  feedback       String?   @db.Text @map("feedback")
  evaluatedAt    DateTime  @default(now()) @map("evaluated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  submission Submission    @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  evaluator  AdminAccount? @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([evaluatorId])
  @@index([teamId])
  @@index([roundNumber])
  @@map("evaluations")
}

// ------------------------------------------------------------------------------
// H. ACTIVITY LOG
// ------------------------------------------------------------------------------
model ActivityLog {
  id          String    @id @default(cuid())
  actorType   ActorType @map("actor_type")
  actorId     String?   @map("actor_id")
  action      String    @map("action")
  description String    @db.Text @map("description")
  metadata    Json?     @map("metadata")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([actorType, actorId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ------------------------------------------------------------------------------
// I. TEAM SESSION (Single Active Participant Session Enforcement)
// ------------------------------------------------------------------------------
model TeamSession {
  id                String                    @id @default(cuid())
  teamId            String                    @map("team_id")
  participantId     String                    @map("participant_id")
  tokenHash         String?                   @map("token_hash")
  status            SessionStatus             @default(ACTIVE)
  terminationReason SessionTerminationReason? @map("termination_reason")
  ipAddress         String?                   @map("ip_address")
  userAgent         String?                   @map("user_agent")
  loginAt           DateTime                  @default(now()) @map("login_at")
  lastActivityAt    DateTime                  @default(now()) @map("last_activity_at")
  logoutAt          DateTime?                 @map("logout_at")
  createdAt         DateTime                  @default(now()) @map("created_at")

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([participantId, status])
  @@index([lastActivityAt])
  @@map("team_sessions")
}

// ------------------------------------------------------------------------------
// J. COMPETITION STATE (Authoritative Global State Machine & Server Timer)
// ------------------------------------------------------------------------------
model CompetitionState {
  id                       String            @id @default("global")
  status                   CompetitionStatus @default(STANDBY)
  currentRoundNumber       Int?              @map("current_round_number")
  isPaused                 Boolean           @default(false) @map("is_paused")
  startedAt                DateTime?         @map("started_at")
  deadlineAt               DateTime?         @map("deadline_at")
  pausedAt                 DateTime?         @map("paused_at")
  remainingDurationSeconds  Int?              @map("remaining_duration_seconds")
  totalDurationSeconds     Int?              @map("total_duration_seconds")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  @@map("competition_state")
}

// ------------------------------------------------------------------------------
// K. WORKSPACE DRAFT (Persistent Shared Team Coding Workspace)
// ------------------------------------------------------------------------------
model WorkspaceDraft {
  id                        String           @id @default(cuid())
  teamId                    String           @map("team_id")
  roundId                   String           @map("round_id")
  caseNumber                Int              @default(1) @map("case_number")
  sourceCode                String           @db.LongText @map("source_code")
  language                  String           @map("language")
  version                   Int              @default(1) @map("version")
  lastEditedByParticipantId String?          @map("last_edited_by_participant_id")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")

  team                      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  round                     CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@unique([teamId, roundId, caseNumber])
  @@index([teamId])
  @@index([roundId])
  @@map("workspace_drafts")
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ------------------------------------------------------------------------------
// L. ANNOUNCEMENT (Administrative Tournament Announcements)
// ------------------------------------------------------------------------------
model Announcement {
  id          String               @id @default(cuid())
  title       String               @map("title")
  message     String               @db.Text @map("message")
  priority    AnnouncementPriority @default(NORMAL)
  isPublished Boolean              @default(false) @map("is_published")
  publishedAt DateTime?            @map("published_at")
  authorId    String?              @map("author_id")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  author      AdminAccount?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPublished, publishedAt])
  @@index([createdAt])
  @@map("announcements")
}

// ------------------------------------------------------------------------------
// M. QUESTION
// ------------------------------------------------------------------------------
model Question {
  id              String       @id @default(cuid())
  roundId         String       @map("round_id")
  type            QuestionType @default(MCQ)
  orderNumber     Int          @map("order_number")
  caseNumber      Int?         @map("case_number") // For Round 3 (1, 2, or 3)
  title           String       @map("title")
  description     String       @db.LongText @map("description")
  starterCode     String?      @db.LongText @map("starter_code")
  language        String?      @map("language")
  marks           Decimal      @default(2.00) @db.Decimal(6, 2) @map("marks")
  options         Json?        @map("options") // Array of string options: ["Option A", "Option B", ...]
  correctOption   Int?         @map("correct_option") // 0-based index for MCQ, strictly protected
  explanation     String?      @db.Text @map("explanation") // For MCQ or bug solution review
  sampleTestCases Json?        @map("sample_test_cases") // [{ stdin, expectedOutput, explanation }]
  hiddenTestCases Json?        @map("hidden_test_cases") // [{ stdin, expectedOutput, marks }] - strictly protected
  rubric          Json?        @map("rubric") // Criteria breakdown for evaluation
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  round       CompetitionRound @relation(fields: [roundId], references: [id], onDelete: Restrict)
  submissions Submission[]
  mcqAnswers  TeamMcqAnswer[]

  @@unique([roundId, orderNumber])
  @@index([roundId])
  @@index([type])
  @@map("questions")
}

// ------------------------------------------------------------------------------
// N. TEAM MCQ ANSWER
// ------------------------------------------------------------------------------
model TeamMcqAnswer {
  id             String    @id @default(cuid())
  teamId         String    @map("team_id")
  questionId     String    @map("question_id")
  selectedOption Int?      @map("selected_option") // 0-based index, nullable if unselected
  isFlagged      Boolean   @default(false) @map("is_flagged") // marked for review by team
  savedAt        DateTime  @default(now()) @map("saved_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([teamId, questionId])
  @@index([teamId])
  @@index([questionId])
  @@map("team_mcq_answers")
}


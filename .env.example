# ==============================================================================
# IGNITRON 2K26 — CODE RELAY ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env

# Environment mode: development | production | test
NODE_ENV=development

# Frontend application port (Vite)
FRONTEND_PORT=5173

# Backend server port (NestJS)
BACKEND_PORT=4000

# Backend global REST API prefix (e.g. "api" maps to /api)
API_PREFIX=api

# Database connection URL (MySQL Community Edition 8.0)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Option 1 (Docker Compose default):
DATABASE_URL="mysql://ignitron_user:ignitron_pass@localhost:3306/ignitron_2k26"
#
# Option 2 (Native MySQL root):
# DATABASE_URL="mysql://root:YOUR_ROOT_PASSWORD@localhost:3306/ignitron_2k26"

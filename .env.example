# ==============================================================================
# IGNITRON 2K26 — CODE RELAY ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env

# Environment mode: development | production | test
NODE_ENV=development

# Frontend application port (Vite)
FRONTEND_PORT=5173

# Backend server port (NestJS)
BACKEND_PORT=4000

# Backend global REST API prefix (e.g. "api" maps to /api)
API_PREFIX=api

# Database connection URL (MySQL Community Edition 8.0)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Option 1 (Docker Compose default):
DATABASE_URL="mysql://ignitron_user:ignitron_pass@localhost:3306/ignitron_2k26"
#
# Option 2 (Native MySQL root on Windows):
# DATABASE_URL="mysql://root:YOUR_SECURE_PASSWORD@localhost:3306/ignitron_2k26"

# Authentication & Security
# WARNING: Change this secret to a cryptographically secure random string in production!
JWT_SECRET="replace-with-a-secure-random-64-character-secret"
JWT_EXPIRES_IN="24h"

# Default Bootstrap Administrator Credentials
ADMIN_EMAIL="admin@ignitron.local"
ADMIN_PASSWORD="ReplaceWithSecureAdminPassword2026!"
ADMIN_FULL_NAME="IGNITRON System Administrator"

# Judge0 CE Integration (Local self-hosted Docker engine)
# Set to local Docker endpoint; defaults to http://localhost:2358
JUDGE0_API_URL="http://localhost:2358"
